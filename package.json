{
  "name": "cadence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H localhost -p 3020",
    "build": "prisma generate && next build",
    "start": "next start -H localhost -p 3020",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:status": "prisma migrate status",
    "db:new-migration": "prisma migrate dev --create-only",
    "db:reset-cadence-schema": "tsx prisma/reset-schema.ts",
    "test:db": "CADENCE_DB_WRITE_TESTS=1 vitest run",
    "audit:etiquette": "tsx scripts/etiquette-audit.ts",
    "gate": "CADENCE_GATE=1 CADENCE_DB_WRITE_TESTS=1 vitest run src/lib/db/gate-preconditions.test.ts src/lib/ingest/parse-twice.test.ts src/lib/extract/sanitize.test.ts src/lib/extract/corpus-round-trip.test.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.7",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dompurify": "^3.5.0",
    "feedsmith": "^3.1.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.72.0",
    "motion": "^12.23.12",
    "next": "16.4.6",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
