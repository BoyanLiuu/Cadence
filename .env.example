# Copy to `.env` (NOT `.env.local` — the Prisma CLI does not read `.env.local`,
# so splitting them yields a working app and a failing migration) and fill in
# from the Supabase dashboard: Connect → ORMs → Prisma.
#
# Two URLs, and getting them the wrong way round is the most common way to
# break this setup:
#
#   DATABASE_URL  Transaction pooler, port 6543. Serverless functions open a
#                 connection per invocation and will exhaust a direct one.
#                 Needs ?pgbouncer=true so Prisma stops using prepared
#                 statements.
#
#   DIRECT_URL    Session pooler, port 5432. Migrations only — `prisma migrate`
#                 cannot run over transaction-mode pooling.
#
# Prefer the session pooler host over `db.<ref>.supabase.co` for DIRECT_URL:
# the `db.*` host is IPv6-only without the paid IPv4 add-on.
#
# If outbound 6543 is blocked on your network, point both at 5432 and drop
# ?pgbouncer=true. The symptoms are distinct: a wrong password is `28P01`, a
# blocked port is `ETIMEDOUT`. Do not rotate credentials at a firewall.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Connections this process may hold. Optional; defaults to 3. The budget is per
# PROCESS and Next runs several render workers, so the real ceiling is
# `workers x max`.
# DATABASE_POOL_MAX=3
